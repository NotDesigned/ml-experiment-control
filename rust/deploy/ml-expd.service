[Unit]
Description=ML-Expd native experiment API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ml-expd
Group=ml-expd
UMask=0077
ExecStart=/opt/ml-expd/bin/ml-expd-rs --config /opt/ml-expd/state/server.json
WorkingDirectory=/opt/ml-expd
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/ml-expd/state
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
