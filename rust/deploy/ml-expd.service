[Unit]
Description=ML-Expd native experiment API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ml-expd
Group=ml-expd
UMask=0077
ExecStart=/opt/ml-exp/bin/ml-expd-rs --config /etc/ml-exp/server.json
WorkingDirectory=/opt/ml-exp
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/ml-exp /srv/ml-exp
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
